# =====================================================================
# Modelo de variáveis de ambiente. Copie para infra/.env e preencha.
# O arquivo .env real NUNCA vai para o repositório (ver .gitignore).
# =====================================================================

# Domínio público da aplicação
DOMINIO=disney.cativa.tur.br

# Banco de dados (o docker-compose monta a DATABASE_URL a partir daqui)
POSTGRES_DB=disney_expert
POSTGRES_USER=disney
POSTGRES_PASSWORD=            # gere uma senha forte

# Aplicação
NODE_ENV=production
APP_URL=https://disney.cativa.tur.br
SESSAO_SECRET=               # 32+ caracteres aleatórios (assina os cookies de sessão)

# Acesso ao CRM interno da especialista (/painel)
PAINEL_SENHA=                # senha compartilhada do painel interno

# Segredo para disparar a fila de e-mails por cron (POST /api/fila)
FILA_SEGREDO=                # string aleatória; usada no header x-segredo

# Envio de e-mail (Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_REMETENTE="Consultoria Orlando Expert · Cativa <disney@envios.cativa.tur.br>"
EMAIL_RESPOSTA=disney@cativa.tur.br
EMAIL_ESPECIALISTA=disney@cativa.tur.br
# EMAIL_TESTE: se preenchido, TODA mensagem vai para este endereço (modo de teste).
EMAIL_TESTE=

# Proteção contra robô (Cloudflare Turnstile) — opcional
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Backup
RCLONE_DESTINO=
URL_MONITOR_BACKUP=
